# Copy to .env.local for local development. Never commit real values.
# NOTE: every VITE_ variable is bundled into public client JS. Only put
# values here that are safe for anyone to read.

# EmailJS (used by the contact form until the backend endpoint exists)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend API base URL, e.g. https://api.tanzim-rahman.com/api
# Leave empty to use the static content in src/data.
VITE_API_URL=
